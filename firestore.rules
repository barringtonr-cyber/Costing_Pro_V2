rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == "barringtonr@gmail.com";
    }

    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validations (Type & Bounds only)
    function validateMaterial(m) {
      return m.get('name', 'x') is string && m.get('name', 'x').size() <= 200;
    }

    function validateProduct(p) {
      return p.get('name', 'x') is string && p.get('name', 'x').size() <= 200;
    }

    function validateSale(s) {
      return s.get('productId', 'x') is string;
    }

    function validateVendor(v) {
      return v.get('name', 'x') is string && v.get('name', 'x').size() <= 200;
    }

    function validateUser(u) {
      return u.get('email', 'x') is string;
    }

    // Rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && validateUser(request.resource.data);
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && 
                    validateUser(request.resource.data) &&
                    (isAdmin() || (request.resource.data.get('role', resource.data.role) == resource.data.role));
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    match /materials/{materialId} {
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(materialId) && 
                    request.resource.data.userId == request.auth.uid &&
                    validateMaterial(request.resource.data);
      allow update: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin()) && 
                    validateMaterial(request.resource.data) &&
                    (isAdmin() || (request.resource.data.get('userId', resource.data.userId) == resource.data.userId));
      allow delete: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /products/{productId} {
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(productId) && 
                    request.resource.data.userId == request.auth.uid &&
                    validateProduct(request.resource.data);
      allow update: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin()) && 
                    validateProduct(request.resource.data) &&
                    (isAdmin() || (request.resource.data.get('userId', resource.data.userId) == resource.data.userId));
      allow delete: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /sales/{saleId} {
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(saleId) && 
                    request.resource.data.userId == request.auth.uid &&
                    validateSale(request.resource.data);
      allow update: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin()) && 
                    validateSale(request.resource.data) &&
                    (isAdmin() || (request.resource.data.get('userId', resource.data.userId) == resource.data.userId));
      allow delete: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /vendors/{vendorId} {
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(vendorId) && 
                    request.resource.data.userId == request.auth.uid &&
                    validateVendor(request.resource.data);
      allow update: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin()) && 
                    validateVendor(request.resource.data) &&
                    (isAdmin() || (request.resource.data.get('userId', resource.data.userId) == resource.data.userId));
      allow delete: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /stock_logs/{logId} {
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(logId) && 
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; 
    }
  }
}
